// RuneCodex — foundation schema.
// Database: Neon PostgreSQL (production). URL comes from DATABASE_URL.
//
// Catalog rule: Creature is the single master record for hunts AND bestiary.
// Charm recommendations belong to HuntCreature (hunt composition), never to Creature.
//
// Bestiary estimated time is NOT stored. It is derived as:
//   ceil(BestiaryEntry.killsRequired / BestiaryEntry.estimatedKillsPerHour)
// when estimatedKillsPerHour is present.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum ElementType {
  PHYSICAL
  FIRE
  ICE
  EARTH
  ENERGY
  HOLY
  DEATH
}

/// Vocations used by HuntVocation only.
/// Character.vocation remains a free-form String for compatibility with the existing User/Character flow.
enum Vocation {
  EK
  RP
  ED
  MS
}

/// Offensive / unique-slot charms. All values in this enum occupy one charm slot per hunt.
enum Charm {
  WOUND
  POISON
  ENFLAME
  FREEZE
  ZAP
  CURSE
  DIVINE_WRATH
  OVERPOWER
  OVERFLUX
}

model User {
  id                String                  @id @default(uuid())
  email             String                  @unique
  passwordHash      String
  role              UserRole                @default(USER)
  activeCharacterId String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  characters        Character[]
  activeCharacter   Character?              @relation("ActiveCharacter", fields: [activeCharacterId], references: [id], onDelete: SetNull)
  bestiaryProgress  UserBestiaryProgress[]
  forumThreads           ForumThread[]
  forumReplies           ForumReply[]
  rewardWallet           RewardWallet?
  missionProgress        UserMissionProgress[]
  rewardRedemptions      RewardRedemption[]
  rewardLedgerEntries    RewardLedgerEntry[]
  rewardEventReceipts    RewardEventReceipt[]
  approvedRedemptions    RewardRedemption[]              @relation("RedemptionApprovedBy")
  deliveredRedemptions   RewardRedemption[]              @relation("RedemptionDeliveredBy")
  cancelledRedemptions   RewardRedemption[]              @relation("RedemptionCancelledBy")
  redemptionStatusEvents RewardRedemptionStatusEvent[]
}

model Character {
  id            String   @id @default(uuid())
  userId        String
  name          String
  vocation      String
  level         Int      @default(1)
  world         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForUser User?    @relation("ActiveCharacter")

  @@index([userId])
}

/// Master creature catalog. Shared by Hunts, Bestiary, and future features.
model Creature {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  /// Asset path relative to apps/mobile/assets/, preserving real filenames.
  image       String
  hp          Int?
  experience  Int?
  difficulty  Difficulty?
  description String?
  youtubeUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  elements          CreatureElement[]
  locations         CreatureLocation[]
  togetherFrom      CreatureTogether[]     @relation("CreatureTogetherFrom")
  togetherTo        CreatureTogether[]     @relation("CreatureTogetherTo")
  huntAppearances   HuntCreature[]
  bestiaryEntry     BestiaryEntry?
  userProgress      UserBestiaryProgress[]

  @@index([isActive])
}

/// Elemental modifiers of a creature (e.g. HOLY = 120). Values are not categorized in the database.
model CreatureElement {
  id         String      @id @default(uuid())
  creatureId String
  element    ElementType
  modifier   Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  creature   Creature    @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([creatureId, element])
  @@index([creatureId])
}

model CreatureLocation {
  id         String   @id @default(uuid())
  creatureId String
  name       String
  region     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([creatureId, name])
  @@index([creatureId])
}

/// Recommended companions to kill together. Both sides point at Creature master records.
model CreatureTogether {
  id                String   @id @default(uuid())
  creatureId        String
  relatedCreatureId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creature          Creature @relation("CreatureTogetherFrom", fields: [creatureId], references: [id], onDelete: Cascade)
  relatedCreature   Creature @relation("CreatureTogetherTo", fields: [relatedCreatureId], references: [id], onDelete: Cascade)

  @@unique([creatureId, relatedCreatureId])
  @@index([creatureId])
  @@index([relatedCreatureId])
}

model Hunt {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  location    String
  subLocation String?
  difficulty  Difficulty
  respawn     String?
  description String?
  /// Optional hunt-specific hero. Frontend may fall back to hunts_hero.webp when null.
  heroImage   String?
  /// Asset path relative to apps/mobile/assets/, e.g. maps/cyclops.png
  mapImage    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vocations HuntVocation[]
  creatures HuntCreature[]
  loot      HuntLoot[]
  videos    HuntVideo[]

  @@index([isActive])
}

/// Per-vocation stats for a hunt. XP/h, profit/h and level live here, not on Hunt.
model HuntVocation {
  id             String      @id @default(uuid())
  huntId         String
  vocation       Vocation
  isRecommended  Boolean     @default(false)
  levelMin       Int
  levelMax       Int?
  xpPerHour      Int
  profitPerHour  Int
  difficulty     Difficulty?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  hunt           Hunt        @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@unique([huntId, vocation])
  @@index([huntId])
  @@index([vocation])
}

model HuntCreature {
  id               String       @id @default(uuid())
  huntId           String
  creatureId       String
  damageType       ElementType?
  isPrimary        Boolean      @default(false)
  quantity         Int?
  /// Charm recommendation for THIS hunt composition. Never stored on Creature.
  recommendedCharm Charm?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  hunt             Hunt         @relation(fields: [huntId], references: [id], onDelete: Cascade)
  creature         Creature     @relation(fields: [creatureId], references: [id], onDelete: Restrict)

  @@unique([huntId, creatureId])
  /// One unique-slot charm per hunt. PostgreSQL UNIQUE treats NULL as distinct,
  /// so multiple creatures without a recommendation are allowed.
  /// All current Charm values are unique-slot; a partial index would be needed
  /// later if a stackable charm is introduced.
  @@unique([huntId, recommendedCharm])
  @@index([huntId])
  @@index([creatureId])
}

model HuntLoot {
  id             String   @id @default(uuid())
  huntId         String
  itemName       String
  itemImage      String?
  estimatedValue Int?
  importance     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  hunt           Hunt     @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId])
}

model HuntVideo {
  id            String   @id @default(uuid())
  huntId        String
  title         String
  url           String
  channel       String?
  isRecommended Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hunt          Hunt     @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId])
}

/// Bestiary-specific official data. Name, image, HP, XP and difficulty come from Creature.
model BestiaryEntry {
  id                    String   @id @default(uuid())
  creatureId            String   @unique
  category              String?
  killsRequired         Int
  /// Reference rate used to derive estimated time: hours ≈ ceil(killsRequired / estimatedKillsPerHour).
  estimatedKillsPerHour Int?
  charmPoints           Int?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  creature              Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
}

/// Per-user bestiary progress. Must not mix with official Creature / BestiaryEntry data.
model UserBestiaryProgress {
  id          String    @id @default(uuid())
  userId      String
  creatureId  String
  kills       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creature    Creature  @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([userId, creatureId])
  @@index([userId])
  @@index([creatureId])
}

enum ForumThreadStatus {
  OPEN
  CLOSED
}

model ForumThread {
  id        String            @id @default(uuid())
  authorId  String
  title     String
  body      String
  status    ForumThreadStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model ForumReply {
  id        String      @id @default(uuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
}

enum RewardMissionPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum RewardMissionCategory {
  BESTIARY
  EXPLORATION
  COMMUNITY
  HUNT
  RECRUITMENT
  PROMOTION
  KNOWLEDGE
  MUSIC
}

enum RewardCurrency {
  GOLD
  DIAMOND
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  DELIVERED
  CANCELLED
}

enum RewardLedgerType {
  MISSION_REWARD
  POINTS_TO_GOLD
  GOLD_TO_DIAMOND
  REDEMPTION
  REFUND
  ADJUSTMENT
}

/// One wallet per user. Balances must never go negative (enforced in SQL + service).
model RewardWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  points    Int      @default(0)
  gold      Int      @default(0)
  diamond   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    RewardLedgerEntry[]
  redemptions RewardRedemption[]

  @@index([userId])
}

model RewardMission {
  id           String                 @id @default(uuid())
  title        String
  description  String
  category     RewardMissionCategory
  period       RewardMissionPeriod
  target       Int
  pointsReward Int
  imageKey     String
  /// Real app event that increments this mission. Null = not automatable yet.
  eventType    String?
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  progress     UserMissionProgress[]
  eventReceipts RewardEventReceipt[]

  @@index([active, period])
  @@index([category])
  @@index([eventType, active])
}

/// Recurring progress is scoped by periodStart (daily/weekly/monthly window).
model UserMissionProgress {
  id          String        @id @default(uuid())
  userId      String
  missionId   String
  progress    Int           @default(0)
  completed   Boolean       @default(false)
  completedAt DateTime?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     RewardMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, periodStart])
  @@index([userId])
  @@index([missionId])
}

/// Idempotency for real-world events (one reference per mission per period).
model RewardEventReceipt {
  id          String        @id @default(uuid())
  userId      String
  eventType   String
  referenceId String
  missionId   String
  periodStart DateTime
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     RewardMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, referenceId, missionId, periodStart])
  @@index([userId, eventType])
}

model RewardCatalogItem {
  id          String         @id @default(uuid())
  name        String
  description String
  imageKey    String         @unique
  currency    RewardCurrency
  /// Commercial price. 0 means not configured yet; redeem is rejected until set.
  price       Int            @default(0)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  redemptions RewardRedemption[]

  @@index([active, sortOrder])
}

model RewardRedemption {
  id                  String                 @id @default(uuid())
  userId              String
  walletId            String
  catalogItemId       String
  currency            RewardCurrency
  /// Price charged at request time. Independent from later catalog changes.
  amount              Int
  quantity            Int                    @default(1)
  status              RewardRedemptionStatus @default(PENDING)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  approvedAt          DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  approvedByUserId    String?
  deliveredByUserId   String?
  cancelledByUserId   String?
  adminNote           String?
  cancellationReason  String?
  deliveryNote        String?
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet              RewardWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  catalogItem         RewardCatalogItem      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  approvedBy          User?                  @relation("RedemptionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  deliveredBy         User?                  @relation("RedemptionDeliveredBy", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  cancelledBy         User?                  @relation("RedemptionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  statusEvents        RewardRedemptionStatusEvent[]

  @@index([userId, createdAt])
  @@index([catalogItemId])
  @@index([status])
}

/// Append-only status audit for redemptions.
model RewardRedemptionStatusEvent {
  id           String                  @id @default(uuid())
  redemptionId String
  fromStatus   RewardRedemptionStatus?
  toStatus     RewardRedemptionStatus
  actorUserId  String
  note         String?
  createdAt    DateTime                @default(now())
  redemption   RewardRedemption        @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  actor        User                    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([redemptionId, createdAt])
}

/// Append-only economy log. Never update rows to "fix" a balance.
model RewardLedgerEntry {
  id            String           @id @default(uuid())
  userId        String
  walletId      String
  type          RewardLedgerType
  pointsDelta   Int              @default(0)
  goldDelta     Int              @default(0)
  diamondDelta  Int              @default(0)
  referenceType String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        RewardWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId])
  @@index([type])
}
