// RuneCodex — foundation schema.
// Database: Neon PostgreSQL (production). URL comes from DATABASE_URL.
//
// Catalog rule: Creature is the single master record for hunts AND bestiary.
// Charm recommendations belong to HuntCreature (hunt composition), never to Creature.
//
// Bestiary estimated time is NOT stored. It is derived as:
//   ceil(BestiaryEntry.killsRequired / BestiaryEntry.estimatedKillsPerHour)
// when estimatedKillsPerHour is present.
// A creature's rate in one hunt is HuntCreature.killPerHour, not that global rate.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum ElementType {
  PHYSICAL
  FIRE
  ICE
  EARTH
  ENERGY
  HOLY
  DEATH
}

/// Vocations used by HuntVocation only.
/// Character.vocation remains a free-form String for compatibility with the existing User/Character flow.
enum Vocation {
  EK
  RP
  ED
  MS
  EM
}

/// Offensive / unique-slot charms. All values in this enum occupy one charm slot per hunt.
enum Charm {
  WOUND
  POISON
  ENFLAME
  FREEZE
  ZAP
  CURSE
  DIVINE_WRATH
  OVERPOWER
  OVERFLUX
}

model User {
  id                String                  @id @default(uuid())
  email             String                  @unique
  /// Null when the account can only sign in with Google.
  passwordHash      String?
  /// Google subject (`sub`). Unique when present; never grants a role or Premium.
  googleSub         String?                 @unique
  role              UserRole                @default(USER)
  /// Public referral code. Not a session token and not a sequential user id.
  referralCode      String?                 @unique
  activeCharacterId String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  characters        Character[]
  activeCharacter   Character?              @relation("ActiveCharacter", fields: [activeCharacterId], references: [id], onDelete: SetNull)
  bestiaryProgress  UserBestiaryProgress[]
  forumThreads           ForumThread[]
  forumReplies           ForumReply[]
  huntComments           HuntComment[]
  huntCommentLikes       HuntCommentLike[]
  huntUpdateRequests     HuntUpdateRequest[]
  decidedHuntUpdates     HuntUpdateRequest[]             @relation("HuntUpdateDecidedBy")
  rewardWallet           RewardWallet?
  missionProgress        UserMissionProgress[]
  rewardRedemptions      RewardRedemption[]
  rewardLedgerEntries    RewardLedgerEntry[]
  rewardEventReceipts    RewardEventReceipt[]
  approvedRedemptions    RewardRedemption[]              @relation("RedemptionApprovedBy")
  deliveredRedemptions   RewardRedemption[]              @relation("RedemptionDeliveredBy")
  cancelledRedemptions   RewardRedemption[]              @relation("RedemptionCancelledBy")
  redemptionStatusEvents RewardRedemptionStatusEvent[]
  authSessions           AuthSession[]
  tickets                Ticket[]
  resolvedTickets        Ticket[]                    @relation("TicketResolvedBy")
  billingOrders          BillingOrder[]
  billingLicenses        BillingLicense[]
  billingStoreEntitlements BillingStoreEntitlement[]
  assignedTickets        Ticket[]                    @relation("TicketAssignee")
  ticketMessages         TicketMessage[]
  auditEvents            AdminAuditEvent[]
  updatedAdminSettings   AdminSetting[]
  contentViews           ContentViewEvent[]
  grantedLicenses        BillingLicense[]             @relation("LicenseGrantedBy")
  createdVouchers        BillingVoucher[]             @relation("VoucherCreatedBy")
  voucherRedemptions     BillingVoucherRedemption[]
  licenseGrantsReceived  BillingLicenseGrant[]        @relation("GrantBeneficiary")
  licenseGrantsIssued    BillingLicenseGrant[]        @relation("GrantActor")
  authDevices            AuthDevice[]
  referralsMade          ReferralAttribution[] @relation("ReferralReferrer")
  referralReceived       ReferralAttribution?  @relation("ReferralReferred")
  referralRewardsEarned  ReferralReward[]      @relation("ReferralRewardEarner")
  referralRewardsConfirmed ReferralReward[]    @relation("ReferralRewardDeliveredBy")
}

/// Active login. Logout deletes this row, so that token stops working.
/// Other devices keep their own rows. Expired rows are removed on the next login.
/// deviceId is null only for sessions created before device binding.
model AuthSession {
  id        String      @id @default(uuid())
  userId    String
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    AuthDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([deviceId])
}

enum ReferralRewardStatus {
  PENDING_DELIVERY
  DELIVERED
  INELIGIBLE
  ON_HOLD
}

enum ReferralStage {
  WAITING_PURCHASE
  REWARDED
}

/// One friend can be attributed once. The referrer cannot be changed later.
model ReferralAttribution {
  id             String        @id @default(uuid())
  referrerUserId String
  referredUserId String        @unique
  code           String
  stage          ReferralStage @default(WAITING_PURCHASE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  referrer       User          @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Restrict)
  referred       User          @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)
  reward         ReferralReward?

  @@index([referrerUserId, createdAt])
  @@index([code])
}

/// Manual 100 TC reward. One row per attribution and per eligible order.
model ReferralReward {
  id                String               @id @default(uuid())
  attributionId     String               @unique
  referrerUserId    String
  referredUserId    String
  tibiaCoins        Int                  @default(100)
  status            ReferralRewardStatus @default(PENDING_DELIVERY)
  orderId           String               @unique
  paymentId         String?
  licenseId         String?
  ticketId          String?              @unique
  holdReason        String?
  reviewRequired    Boolean              @default(false)
  reviewReason      String?
  releasedAt        DateTime             @default(now())
  deliveredAt       DateTime?
  deliveredByUserId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attribution       ReferralAttribution  @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  referrer          User                 @relation("ReferralRewardEarner", fields: [referrerUserId], references: [id], onDelete: Restrict)
  deliveredBy       User?                @relation("ReferralRewardDeliveredBy", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  ticket            Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([referrerUserId, createdAt])
}

enum AuthDeviceStatus {
  ACTIVE
  REVOKED
}

/// A linked browser installation. The private key never leaves the browser.
/// At most two ACTIVE rows per user: slots 1 and 2, enforced by a partial unique index.
model AuthDevice {
  id             String           @id @default(uuid())
  userId         String
  installationId String
  publicKeyHash  String
  publicKeySpki  String
  label          String
  deviceType     String?
  osName         String?
  clientName     String?
  status         AuthDeviceStatus @default(ACTIVE)
  slot           Int?
  createdAt      DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  revokedAt      DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       AuthSession[]

  @@unique([userId, installationId])
  @@index([userId, status])
}

/// Short-lived nonce signed by the device private key. Possession of the public id is not enough.
model AuthDeviceChallenge {
  id             String    @id @default(uuid())
  installationId String
  publicKeyHash  String
  publicKeySpki  String
  nonce          String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

model Character {
  id            String   @id @default(uuid())
  userId        String
  name          String
  vocation      String
  level         Int      @default(1)
  world         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForUser User?    @relation("ActiveCharacter")

  @@index([userId])
}

/// Master creature catalog. Shared by Hunts, Bestiary, and future features.
model Creature {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  /// Asset path relative to apps/mobile/assets/, preserving real filenames.
  image       String
  hp          Int?
  experience  Int?
  difficulty  Difficulty?
  description String?
  youtubeUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  elements          CreatureElement[]
  locations         CreatureLocation[]
  togetherFrom      CreatureTogether[]     @relation("CreatureTogetherFrom")
  togetherTo        CreatureTogether[]     @relation("CreatureTogetherTo")
  huntAppearances   HuntCreature[]
  bestiaryEntry     BestiaryEntry?
  userProgress      UserBestiaryProgress[]
  tickets           Ticket[]

  @@index([isActive])
  @@index([name])
  @@index([isActive, name])
  @@index([isActive, difficulty, name])
}

/// Elemental modifiers of a creature (e.g. HOLY = 120). Values are not categorized in the database.
model CreatureElement {
  id         String      @id @default(uuid())
  creatureId String
  element    ElementType
  modifier   Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  creature   Creature    @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([creatureId, element])
  @@index([creatureId])
}

model CreatureLocation {
  id         String   @id @default(uuid())
  creatureId String
  name       String
  region     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([creatureId, name])
  @@index([creatureId])
}

/// Recommended companions to kill together. Both sides point at Creature master records.
model CreatureTogether {
  id                String   @id @default(uuid())
  creatureId        String
  relatedCreatureId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  creature          Creature @relation("CreatureTogetherFrom", fields: [creatureId], references: [id], onDelete: Cascade)
  relatedCreature   Creature @relation("CreatureTogetherTo", fields: [relatedCreatureId], references: [id], onDelete: Cascade)

  @@unique([creatureId, relatedCreatureId])
  @@index([creatureId])
  @@index([relatedCreatureId])
}

model Hunt {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  /// ILIKE contains cannot use a btree index. The GIN index uses pg_trgm.
  location    String
  subLocation String?
  difficulty  Difficulty
  respawn     String?
  description String?
  /// Optional hunt-specific hero. Frontend may fall back to hunts_hero.webp when null.
  heroImage   String?
  /// Asset path relative to apps/mobile/assets/, e.g. maps/cyclops.png
  mapImage    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vocations HuntVocation[]
  creatures HuntCreature[]
  loot      HuntLoot[]
  videos    HuntVideo[]
  tickets   Ticket[]
  comments  HuntComment[]
  updateRequests HuntUpdateRequest[]

  @@index([isActive])
  @@index([name])
  @@index([isActive, name])
  @@index([isActive, difficulty, name])
  @@index([location(ops: raw("gin_trgm_ops"))], map: "Hunt_location_trgm_idx", type: Gin)
}

/// Per-vocation stats for a hunt. XP/h, profit/h and level live here, not on Hunt.
model HuntVocation {
  id             String      @id @default(uuid())
  huntId         String
  vocation       Vocation
  isRecommended  Boolean     @default(false)
  levelMin       Int
  levelMax       Int?
  xpPerHour      Int
  profitPerHour  Int
  difficulty     Difficulty?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  hunt           Hunt        @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@unique([huntId, vocation])
  @@index([huntId])
  @@index([vocation])
  @@index([vocation, levelMin])
}

model HuntCreature {
  id               String       @id @default(uuid())
  huntId           String
  creatureId       String
  damageType       ElementType?
  isPrimary        Boolean      @default(false)
  quantity         Int?
  /// Charm recommendation for THIS hunt composition. Never stored on Creature.
  recommendedCharm Charm?
  /// Kills per hour for this creature in this hunt. Null until a reviewed estimate is imported.
  killPerHour      Int?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  hunt             Hunt         @relation(fields: [huntId], references: [id], onDelete: Cascade)
  creature         Creature     @relation(fields: [creatureId], references: [id], onDelete: Restrict)

  @@unique([huntId, creatureId])
  /// One unique-slot charm per hunt. PostgreSQL UNIQUE treats NULL as distinct,
  /// so multiple creatures without a recommendation are allowed.
  /// All current Charm values are unique-slot; a partial index would be needed
  /// later if a stackable charm is introduced.
  @@unique([huntId, recommendedCharm])
  @@index([huntId])
  @@index([creatureId])
}

model HuntLoot {
  id             String   @id @default(uuid())
  huntId         String
  itemName       String
  itemImage      String?
  estimatedValue Int?
  importance     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  hunt           Hunt     @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId])
}

model HuntVideo {
  id            String   @id @default(uuid())
  huntId        String
  title         String
  url           String
  channel       String?
  isRecommended Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hunt          Hunt     @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId])
}

/// Public hunt discussion. Replies point at a top-level comment. Removal is a soft delete.
model HuntComment {
  id        String   @id @default(uuid())
  huntId    String
  userId    String
  parentId  String?
  content   String
  isEdited  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hunt    Hunt              @relation(fields: [huntId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  HuntComment?      @relation("HuntCommentThread", fields: [parentId], references: [id], onDelete: Restrict)
  replies HuntComment[]     @relation("HuntCommentThread")
  likes   HuntCommentLike[]

  @@index([huntId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
  @@index([huntId, parentId, createdAt, id])
}

model HuntCommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment HuntComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

enum HuntUpdateRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum HuntUpdateRequestType {
  XP
  PROFIT
  LEVEL
  VOCATION
  CREATURES
  LOCATION
  LOOT
  OTHER
}

/// A player report that one fact on a hunt is outdated. Visible only to its author.
model HuntUpdateRequest {
  id              String                 @id @default(uuid())
  huntId          String
  userId          String
  type            HuntUpdateRequestType
  description     String
  /// Value read from the hunt when the proposal was created. Not trusted from the client.
  currentValue    String?
  /// Present only when the author submitted a structured value. Free text stays in description.
  proposedValue   String?
  vocation        Vocation?
  ticketId        String?                @unique
  status          HuntUpdateRequestStatus @default(OPEN)
  adminResponse   String?
  decidedByUserId String?
  /// Set in the same transaction that writes the authorized hunt field. A second approval does not write again.
  appliedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  resolvedAt      DateTime?
  hunt            Hunt                   @relation(fields: [huntId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy       User?                  @relation("HuntUpdateDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  ticket          Ticket?                @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([huntId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([huntId, userId, createdAt])
  @@index([decidedByUserId])
}

/// Bestiary-specific official data. Name, image, HP, XP and difficulty come from Creature.
model BestiaryEntry {
  id                    String   @id @default(uuid())
  creatureId            String   @unique
  category              String?
  killsRequired         Int
  /// Reference rate used to derive estimated time: hours ≈ ceil(killsRequired / estimatedKillsPerHour).
  estimatedKillsPerHour Int?
  charmPoints           Int?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  creature              Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
}

/// Per-user bestiary progress. Must not mix with official Creature / BestiaryEntry data.
model UserBestiaryProgress {
  id          String    @id @default(uuid())
  userId      String
  creatureId  String
  kills       Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creature    Creature  @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([userId, creatureId])
  @@index([userId])
  @@index([creatureId])
}

enum ForumThreadStatus {
  OPEN
  CLOSED
}

enum ForumCategory {
  BESTIARY
  HUNTS
  PROFIT
  XP
  TIPS
}

model ForumThread {
  id        String            @id @default(uuid())
  authorId  String
  title     String
  body      String
  category  ForumCategory?
  status    ForumThreadStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]

  @@index([authorId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@index([category, createdAt, id])
}

model ForumReply {
  id        String      @id @default(uuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
  @@index([threadId, createdAt, id])
}

enum RewardMissionPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum RewardMissionCategory {
  BESTIARY
  EXPLORATION
  COMMUNITY
  HUNT
  RECRUITMENT
  PROMOTION
  KNOWLEDGE
  MUSIC
}

enum RewardCurrency {
  GOLD
  DIAMOND
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  DELIVERED
  CANCELLED
}

enum RewardLedgerType {
  MISSION_REWARD
  POINTS_TO_GOLD
  GOLD_TO_DIAMOND
  REDEMPTION
  REFUND
  ADJUSTMENT
}

/// One wallet per user. Balances must never go negative (enforced in SQL + service).
model RewardWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  points    Int      @default(0)
  gold      Int      @default(0)
  diamond   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    RewardLedgerEntry[]
  redemptions RewardRedemption[]

  @@index([userId])
}

model RewardMission {
  id           String                 @id @default(uuid())
  title        String
  description  String
  category     RewardMissionCategory
  period       RewardMissionPeriod
  target       Int
  pointsReward Int
  imageKey     String
  /// Real app event that increments this mission. Null = not automatable yet.
  eventType    String?
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  progress     UserMissionProgress[]
  eventReceipts RewardEventReceipt[]

  @@index([active, period])
  @@index([category])
  @@index([eventType, active])
}

/// Recurring progress is scoped by periodStart (daily/weekly/monthly window).
model UserMissionProgress {
  id          String        @id @default(uuid())
  userId      String
  missionId   String
  progress    Int           @default(0)
  completed   Boolean       @default(false)
  completedAt DateTime?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     RewardMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, periodStart])
  @@index([userId])
  @@index([missionId])
}

/// Idempotency for real-world events (one reference per mission per period).
model RewardEventReceipt {
  id          String        @id @default(uuid())
  userId      String
  eventType   String
  referenceId String
  missionId   String
  periodStart DateTime
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     RewardMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, referenceId, missionId, periodStart])
  @@index([userId, eventType])
}

model RewardCatalogItem {
  id          String         @id @default(uuid())
  name        String
  description String
  imageKey    String         @unique
  currency    RewardCurrency
  /// Commercial price. 0 means not configured yet; redeem is rejected until set.
  price       Int            @default(0)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  redemptions RewardRedemption[]

  @@index([active, sortOrder])
}

model RewardRedemption {
  id                  String                 @id @default(uuid())
  userId              String
  walletId            String
  catalogItemId       String
  currency            RewardCurrency
  /// Price charged at request time. Independent from later catalog changes.
  amount              Int
  quantity            Int                    @default(1)
  status              RewardRedemptionStatus @default(PENDING)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  approvedAt          DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  refundedAt          DateTime?
  approvedByUserId    String?
  deliveredByUserId   String?
  cancelledByUserId   String?
  adminNote           String?
  cancellationReason  String?
  deliveryNote        String?
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet              RewardWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  catalogItem         RewardCatalogItem      @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  approvedBy          User?                  @relation("RedemptionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  deliveredBy         User?                  @relation("RedemptionDeliveredBy", fields: [deliveredByUserId], references: [id], onDelete: SetNull)
  cancelledBy         User?                  @relation("RedemptionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  statusEvents        RewardRedemptionStatusEvent[]

  @@index([userId, createdAt])
  @@index([catalogItemId])
  @@index([status])
}

/// Append-only status audit for redemptions.
model RewardRedemptionStatusEvent {
  id           String                  @id @default(uuid())
  redemptionId String
  fromStatus   RewardRedemptionStatus?
  toStatus     RewardRedemptionStatus
  actorUserId  String
  note         String?
  createdAt    DateTime                @default(now())
  redemption   RewardRedemption        @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  actor        User                    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([redemptionId, createdAt])
}

/// Append-only economy log. Never update rows to "fix" a balance.
model RewardLedgerEntry {
  id            String           @id @default(uuid())
  userId        String
  walletId      String
  type          RewardLedgerType
  pointsDelta   Int              @default(0)
  goldDelta     Int              @default(0)
  diamondDelta  Int              @default(0)
  referenceType String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        RewardWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId])
  @@index([type])
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  /// Staff is waiting for the author. Existing OPEN and IN_REVIEW rows are unchanged.
  WAITING_ON_USER
  /// Staff is waiting for another team member. Existing rows are unchanged.
  WAITING_ON_STAFF
  RESOLVED
  REJECTED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketMessageVisibility {
  PUBLIC
  INTERNAL
}

enum ContentSubject {
  HUNT
  CREATURE
  BOSS
}

enum TicketProblemType {
  XP_PER_HOUR
  PROFIT
  HUNT_OUTDATED
  BESTIARY
  DIFFICULTY
  INCORRECT_INFO
  OTHER
}

enum TicketImpact {
  INCORRECT_INFO
  LOW
  MEDIUM
  HIGH
}

enum TicketOrigin {
  HUNT
  BESTIARY
  GENERAL
}

enum TicketPartyFormat {
  SOLO
  PT_2
  PT_3
  PT_4
  PT_5_PLUS
}

/// Party composition reported on a ticket. Separate from Hunt Vocation, which has no Monk.
enum TicketVocation {
  EK
  MS
  ED
  RP
  MONK
}

enum TicketEvidenceSource {
  CAMERA
  DEVICE
}

/// Support ticket. rewardPoints is reserved for a future reputation grant and is not filled here.
model Ticket {
  id               String             @id @default(uuid())
  /// Stable public protocol. Distinct from the internal id.
  protocol         String             @unique
  authorId         String
  status           TicketStatus       @default(OPEN)
  priority         TicketPriority     @default(NORMAL)
  /// Required while priority is URGENT. Hidden from the ticket author.
  urgentReason     String?
  assigneeId       String?
  problemType      TicketProblemType
  impact           TicketImpact
  origin           TicketOrigin
  description      String
  huntId           String?
  creatureId       String?
  playerLevel      Int?
  partyFormat      TicketPartyFormat?
  catalogValue     String?
  userValue        String?
  resolutionNote   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  /// First public staff reply. Internal notes do not set this.
  firstResponseAt  DateTime?
  /// Set when a confirmed catalog correction was written. A repeat apply does nothing.
  contentAppliedAt DateTime?
  rewardPoints     Int?
  rewardGrantedAt  DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  author           User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  assignee         User?              @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedBy       User?              @relation("TicketResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  hunt             Hunt?              @relation(fields: [huntId], references: [id], onDelete: SetNull)
  creature         Creature?          @relation(fields: [creatureId], references: [id], onDelete: SetNull)
  vocations        TicketVocationSelection[]
  evidences        TicketEvidence[]
  messages          TicketMessage[]
  huntUpdateRequest HuntUpdateRequest?
  referralReward    ReferralReward?

  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([huntId])
  @@index([creatureId])
  @@index([assigneeId, status, createdAt])
  @@index([priority, createdAt])
}

/// Public replies and staff-only notes. INTERNAL rows must never leave admin queries.
model TicketMessage {
  id         String                  @id @default(uuid())
  ticketId   String
  authorId   String
  visibility TicketMessageVisibility
  body       String
  createdAt  DateTime                @default(now())
  ticket     Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

/// Append-only staff audit. Ordinary operations must not update or delete these rows.
model AdminAuditEvent {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

/// Staff-owned operational limits. Absent keys mean the related alert is not calculated.
model AdminSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

/// One content open per session, subject and clock hour. History starts at the first stored row.
model ContentViewEvent {
  id          String         @id @default(uuid())
  subject     ContentSubject
  subjectId   String
  sessionKey  String
  userId      String?
  bucketStart DateTime
  createdAt   DateTime       @default(now())
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([sessionKey, subject, subjectId, bucketStart])
  @@index([subject, subjectId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Minimized record of a catalog search that returned no rows. No user id is stored.
model SearchMiss {
  id        String   @id @default(uuid())
  category  String
  term      String
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([createdAt])
}

model TicketVocationSelection {
  ticketId  String
  vocation  TicketVocation
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, vocation])
}

/// File bytes live in object storage. This row keeps only the reference and metadata.
model TicketEvidence {
  id         String               @id @default(uuid())
  ticketId   String
  storageKey String
  url        String?
  mimeType   String
  source     TicketEvidenceSource
  byteSize   Int?
  createdAt  DateTime             @default(now())
  ticket     Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

/// Paid Premium catalog. Separate from RewardCatalogItem, which is the in-app economy.
model BillingProduct {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  prices    BillingPrice[]
  orders    BillingOrder[]
  licenses  BillingLicense[]
  storeEntitlements BillingStoreEntitlement[]
  vouchers  BillingVoucher[]

  @@index([active])
}

enum BillingMarket {
  BR
  INTL
}

enum BillingCurrency {
  BRL
  USD
}

/// Current price for a market. Orders copy amountMinor and currency at purchase time.
model BillingPrice {
  id          String          @id @default(uuid())
  productId   String
  market      BillingMarket
  currency    BillingCurrency
  /// Minor units. BRL 4990 = R$ 49,90. USD 1499 = US$ 14,99.
  amountMinor Int
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  product     BillingProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  orders      BillingOrder[]

  @@unique([productId, market])
  @@index([productId, active])
}

enum BillingOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

/// Commercial order. Status does not describe the provider attempt or the license.
model BillingOrder {
  id          String             @id @default(uuid())
  userId      String
  productId   String
  priceId     String
  market      BillingMarket
  currency    BillingCurrency
  amountMinor Int
  status      BillingOrderStatus @default(PENDING)
  paidAt      DateTime?
  refundedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     BillingProduct     @relation(fields: [productId], references: [id], onDelete: Restrict)
  price       BillingPrice       @relation(fields: [priceId], references: [id], onDelete: Restrict)
  payments    BillingPayment[]
  license     BillingLicense?
  events      BillingEventReceipt[]

  @@index([userId, createdAt])
  @@index([productId])
  @@index([status])
}

enum BillingPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// One provider charge. Many payments may belong to one order. Rows are not deleted.
model BillingPayment {
  id                String               @id @default(uuid())
  orderId           String
  provider            String
  providerPaymentId   String?
  /// Mercado Pago preference id. Distinct from the payment id sent later by webhook.
  providerCheckoutId  String?
  checkoutUrl         String?
  status              BillingPaymentStatus @default(PENDING)
  currency          BillingCurrency
  amountMinor       Int
  paidAt            DateTime?
  refundedAt        DateTime?
  /// Provider status label from the last confirmed lookup. Not a secret and not proof by itself.
  providerStatus    String?
  syncedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             BillingOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            BillingEventReceipt[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status])
}

enum BillingLicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum BillingLicenseSource {
  PURCHASE
  VOUCHER
  ADMIN_GRANT
  PARTNERSHIP
  COMPENSATION
}

enum BillingLicenseTerm {
  LIFETIME
  FIXED
}

enum BillingVoucherBenefit {
  FREE
  PARTNERSHIP
  PROMOTIONAL
}

enum BillingVoucherStatus {
  ACTIVE
  PAUSED
  EXHAUSTED
  CLOSED
}

enum BillingRedemptionResult {
  SUCCESS
  REJECTED
}

enum BillingGrantCategory {
  COLLABORATOR
  PARTNERSHIP
  CONTENT_CREATOR
  COMPENSATION
  OTHER
}

/// Access grant. A purchase keeps its order. Grants and vouchers do not invent a payment.
/// Revocation keeps the row and clears activeUserProductKey. Suspension keeps the key.
model BillingLicense {
  id                   String               @id @default(uuid())
  userId               String
  productId            String
  orderId              String?              @unique
  source               BillingLicenseSource @default(PURCHASE)
  term                 BillingLicenseTerm   @default(LIFETIME)
  status               BillingLicenseStatus @default(ACTIVE)
  /// userId:productId while the row still occupies the product slot. Null after revocation or expiry.
  activeUserProductKey String?              @unique
  expiresAt            DateTime?
  grantedAt            DateTime             @default(now())
  revokedAt            DateTime?
  suspendedAt          DateTime?
  reason               String?
  grantedByUserId      String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  product              BillingProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  order                BillingOrder?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  grantedBy            User?                @relation("LicenseGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  grant                BillingLicenseGrant?
  redemption           BillingVoucherRedemption?

  @@index([userId, productId, status])
  @@index([source, status])
  @@index([expiresAt])
  @@index([grantedByUserId])
}

/// Redeemable code. Only the hash is stored. The plaintext is returned once, at creation.
model BillingVoucher {
  id              String                 @id @default(uuid())
  codeHash        String                 @unique
  codePrefix      String
  benefit         BillingVoucherBenefit
  productId       String
  term            BillingLicenseTerm
  durationDays    Int?
  maxRedemptions  Int
  redeemedCount   Int                    @default(0)
  perUserLimit    Int                    @default(1)
  startsAt        DateTime               @default(now())
  endsAt          DateTime?
  status          BillingVoucherStatus   @default(ACTIVE)
  campaign        String?
  notes           String?
  createdByUserId String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  product         BillingProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy       User                   @relation("VoucherCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  redemptions     BillingVoucherRedemption[]

  @@index([status, endsAt])
  @@index([createdByUserId])
}

model BillingVoucherRedemption {
  id        String                  @id @default(uuid())
  voucherId String
  userId    String
  result    BillingRedemptionResult
  reason    String?
  licenseId String?                 @unique
  createdAt DateTime                @default(now())
  voucher   BillingVoucher          @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  license   BillingLicense?         @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([voucherId, userId])
  @@index([userId, createdAt])
}

/// Administrative grant. This is a business classification, not an authentication role.
model BillingLicenseGrant {
  id           String               @id @default(uuid())
  userId       String
  actorUserId  String
  category     BillingGrantCategory
  reason       String
  term         BillingLicenseTerm
  startsAt     DateTime             @default(now())
  expiresAt    DateTime?
  licenseId    String               @unique
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation("GrantBeneficiary", fields: [userId], references: [id], onDelete: Restrict)
  actor        User                 @relation("GrantActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  license      BillingLicense       @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([actorUserId])
  @@index([category])
}

/// Store entitlements synced from a server-verified external billing provider.
model BillingStoreEntitlement {
  id          String         @id @default(uuid())
  userId      String
  productId   String
  provider    String
  active      Boolean        @default(false)
  syncedAt    DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     BillingProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, provider, productId])
  @@index([provider, productId, active])
}

enum BillingEventType {
  PAYMENT_PENDING
  PAYMENT_PAID
  PAYMENT_FAILED
  PAYMENT_REFUNDED
}

/// Idempotency record for a provider notification. The same provider event is stored once.
model BillingEventReceipt {
  id              String           @id @default(uuid())
  provider        String
  providerEventId String
  type            BillingEventType
  orderId         String
  paymentId       String?
  createdAt       DateTime         @default(now())
  order           BillingOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment         BillingPayment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([orderId])
  @@index([paymentId])
}
