# Staging template. Copy to apps/api/.env.staging on the staging host.
# Do not reuse development or production credentials.
# This file is an example. Real values stay in the staging deploy environment.

APP_ENV=staging
NODE_ENV=production

DATABASE_URL="postgresql://USER:PASSWORD@STAGING_HOST:5432/STAGING_DB?sslmode=require"
STAGING_DATABASE_HOST=STAGING_HOST
PRODUCTION_DATABASE_HOST=PRODUCTION_HOST

JWT_SECRET="replace-with-a-staging-only-secret"
JWT_EXPIRES_IN="7d"

PORT=3000
CORS_ORIGINS=

# Evidence images. Set these in the staging host. Do not reuse production keys.
TICKET_EVIDENCE_MAX_BYTES=5000000
TICKET_STORAGE_DRIVER=s3
TICKET_STORAGE_S3_BUCKET=
TICKET_STORAGE_S3_REGION=
TICKET_STORAGE_S3_ENDPOINT=
TICKET_STORAGE_S3_ACCESS_KEY_ID=
TICKET_STORAGE_S3_SECRET_ACCESS_KEY=
TICKET_STORAGE_S3_FORCE_PATH_STYLE=false
# Optional https origin used to build TicketEvidence.url. Leave empty for a private bucket.
TICKET_STORAGE_PUBLIC_BASE_URL=
