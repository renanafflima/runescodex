# Production template. Set these in the deploy host (Render).
# Do not create apps/api/.env.production on a development machine
# and do not copy production credentials into apps/api/.env.

APP_ENV=production
NODE_ENV=production

DATABASE_URL="postgresql://USER:PASSWORD@PRODUCTION_HOST:5432/PRODUCTION_DB?sslmode=require"
PRODUCTION_DATABASE_HOST=PRODUCTION_HOST
STAGING_DATABASE_HOST=STAGING_HOST

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=3000
CORS_ORIGINS=

# Evidence images. Set these in the production host. Do not copy them into apps/api/.env.
TICKET_EVIDENCE_MAX_BYTES=5000000
TICKET_STORAGE_DRIVER=s3
TICKET_STORAGE_S3_BUCKET=
TICKET_STORAGE_S3_REGION=
TICKET_STORAGE_S3_ENDPOINT=
TICKET_STORAGE_S3_ACCESS_KEY_ID=
TICKET_STORAGE_S3_SECRET_ACCESS_KEY=
TICKET_STORAGE_S3_FORCE_PATH_STYLE=false
# Optional https origin used to build TicketEvidence.url. Leave empty for a private bucket.
TICKET_STORAGE_PUBLIC_BASE_URL=
