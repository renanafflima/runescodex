# Local development. Copy to apps/api/.env.
# Never commit real credentials or point this file at production.

APP_ENV=development
NODE_ENV=development

# Local Docker Postgres from the repository docker-compose.yml.
DATABASE_URL="postgresql://runescodex:runescodex_dev@localhost:5432/runescodex_dev"
DEV_DATABASE_HOST=localhost

# Development only. Staging and production must use different secrets.
JWT_SECRET="dev-only-not-for-production"
JWT_EXPIRES_IN="7d"

# Public Google OAuth client id. The web app uses the same value as VITE_GOOGLE_CLIENT_ID.
# No client secret is required for Sign in with Google ID tokens.
# GOOGLE_CLIENT_ID=

PORT=3000
CORS_ORIGINS=

# Evidence images. Development stores files on local disk.
# Staging and production must use S3-compatible storage. Do not put real keys here.
TICKET_EVIDENCE_MAX_BYTES=5000000
TICKET_STORAGE_DRIVER=local
# TICKET_STORAGE_LOCAL_DIR=
# TICKET_STORAGE_PUBLIC_BASE_URL=
# TICKET_STORAGE_S3_BUCKET=
# TICKET_STORAGE_S3_REGION=
# TICKET_STORAGE_S3_ENDPOINT=
# TICKET_STORAGE_S3_ACCESS_KEY_ID=
# TICKET_STORAGE_S3_SECRET_ACCESS_KEY=
# TICKET_STORAGE_S3_FORCE_PATH_STYLE=false

# Mercado Pago Checkout Pro for RuneCodex Premium (Brazil, one-time).
# Leave these empty until a test account exists. Never commit a real token.
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_NOTIFICATION_URL=http://localhost:3000/billing/webhooks/mercadopago
# MERCADO_PAGO_BACK_URL_SUCCESS=http://localhost:5173/checkout
# MERCADO_PAGO_BACK_URL_PENDING=http://localhost:5173/checkout
# MERCADO_PAGO_BACK_URL_FAILURE=http://localhost:5173/checkout

# RevenueCat native store purchases (iOS/Android). Keep secret API keys server-side.
# REVENUECAT_SECRET_API_KEY=
# REVENUECAT_WEBHOOK_AUTHORIZATION=
