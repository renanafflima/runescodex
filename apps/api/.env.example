# Copy this file to .env and replace placeholders with your own values.
# Never commit real credentials.

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# HTTP
PORT=3000
NODE_ENV=development

# Comma-separated browser origins. Leave empty for local development
# (any origin). In production with this empty, browser CORS is disabled
# (native mobile clients do not need CORS).
CORS_ORIGINS=
